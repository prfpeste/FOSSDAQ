[Unit]
Description=LAN Kontrolltafel (Flask Dashboard)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/lan-dashboard
EnvironmentFile=/home/pi/lan-dashboard/.env
ExecStart=/home/pi/lan-dashboard/venv/bin/gunicorn -w 2 -b 0.0.0.0:5000 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
