# /etc/systemd/system/startup-sequence.service
#
# Führt beim Boot die Startsequenz aus:
# Arduino-Symlinks -> Node-RED -> Webseite (lan-dashboard) -> Hotspot.

[Unit]
Description=Startsequenz: Arduino-Symlinks, Node-RED, Webseite, Hotspot
Wants=network-online.target systemd-udev-settle.service
After=network-online.target systemd-udev-settle.service NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Der Service selbst läuft weiterhin als root (kein User= gesetzt), da er
# udev-Symlinks unter /dev anlegt und den Hotspot per hostapd/iptables
# konfiguriert - das braucht echte Root-Rechte. Node-RED läuft NICHT als
# root, sondern als eigener Benutzer (siehe NODERED_USER unten), den
# startup-sequence.sh per runuser aufruft.
Environment=HOME=/root
EnvironmentFile=-/etc/default/startup-sequence
ExecStart=/usr/local/bin/startup-sequence.sh
# Erhöht (vorher 120s), da die Sequenz jetzt zusätzlich auf die Webseite
# (lan-dashboard.service, max. 30s) wartet.
TimeoutStartSec=150

[Install]
WantedBy=multi-user.target
