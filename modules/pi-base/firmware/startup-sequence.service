# /etc/systemd/system/startup-sequence.service
#
# Executes the startup sequence during boot:
# Arduino symlinks -> Node-RED -> Website (lan-dashboard) -> Hotspot.

[Unit]
Description=Startup sequence: Arduino symlinks, Node-RED, Website, Hotspot
Wants=network-online.target systemd-udev-settle.service
After=network-online.target systemd-udev-settle.service NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The service itself continues to run as root (no User= set), as it
# creates udev symlinks under /dev and configures the hotspot via hostapd/iptables,
# which requires actual root permissions. Node-RED does NOT run as root,
# but as a dedicated user (see NODERED_USER below), which startup-sequence.sh
# calls via runuser.
Environment=HOME=/root
EnvironmentFile=-/etc/default/startup-sequence
ExecStart=/usr/local/bin/startup-sequence.sh
# Increased (previously 120s) because the sequence now additionally waits for the
# website (lan-dashboard.service, max. 30s).
TimeoutStartSec=150

[Install]
WantedBy=multi-user.target
